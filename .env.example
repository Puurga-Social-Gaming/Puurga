# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend / API
JWT_SECRET=your-jwt-secret-here

# ZegoCloud Video/Audio Calls
# Prefer server-side env (backend). Client no longer needs the server secret.
ZEGO_APP_ID=your-zego-app-id
ZEGO_SERVER_SECRET=your-zego-server-secret
# Optional legacy Vite vars (backend falls back to these if ZEGO_* unset):
# VITE_ZEGO_APP_ID=your-zego-app-id
# VITE_ZEGO_SERVER_SECRET=your-zego-server-secret
